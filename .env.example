# Skopiuj do .env.local i uzupełnij. Nigdy nie commituj .env.local.
ANTHROPIC_API_KEY=

# Opcjonalnie: inny model Claude (domyślnie claude-opus-5-5).
# LLM_MODEL=

# Zalecane: User-Agent z kontaktem dla API Wikipedii (wyższe limity zapytań).
# WIKIPEDIA_USER_AGENT="HestoReels/0.1 (https://twoj-projekt.example; kontakt@example.com)"

# Opcjonalnie: plik cookies (format Netscape) dla yt-dlp. Instagram często
# wymaga logowania; bez tego część linków zwróci "wymaga logowania".
# IG_COOKIES_PATH=/sciezka/do/cookies.txt

# Opcjonalnie: katalog na klipy pobrane z linków (domyślnie <tmp>/hestoreels-imports).
# IMPORTS_DIR=

# Opcjonalnie: 1 = tryb offline na demo (odpowiedzi z data/demoResponses.ts).
# NEXT_PUBLIC_OFFLINE_DEMO=1
